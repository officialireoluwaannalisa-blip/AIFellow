# Optional. Defaults are suitable for the local synthetic-data demo.
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=.data/stocksense.sqlite
# Comma-separated exact hostnames for a deployed instance.
ALLOWED_HOSTS=localhost,127.0.0.1
# No API keys are required. No LLM or live procurement integration is enabled.

# Serverless helpers. Normally unnecessary: the dataset root is auto-detected.
# STOCKSENSE_DATA_ROOT=/var/task
# Include the raw initialization error message in API 503 responses. Leave unset
# on public deployments; the full stack is always written to the runtime logs.
# STOCKSENSE_DEBUG_ERRORS=true

# Operator-controlled authorized aggregate ingestion (NOT for the public demo).
# Requires a signed data-sharing authorization, aggregate-only pack, and locally
# approved clinical policy. Patient-level records are never accepted.
# DATA_SHARING_AUTHORIZED=true
# AUTHORIZED_AGGREGATE_PACK_PATH=/secure/path/aggregate-pack.json
# CLINICAL_POLICY_PATH=/secure/path/clinical-policy.json
